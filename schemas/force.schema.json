  "required": [
    "schema",
    "id",
    "name",
    "total",
    "troop_pools"
  ],
  "properties": {
    "schema": {
      "const": "force"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "unit_claims": {
      "type": "array"
    },
    "availability": {
      "type": "object"
    },
    "troop_pools": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
