{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eyes"
  ],
  "properties": {
    "schema": {
      "const": "ocular-registry"
    },
    "eyes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eye_id",
          "side",
          "original_owner_id",
          "current_owner_id",
          "current_location",
          "dojutsu_type",
          "hardware_stage",
          "native_to_current_owner",
          "condition",
          "vision_integrity",
          "integration",
          "activation_state",
          "preservation_state"
        ],
        "properties": {
          "eye_id": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "arm_socket",
              "stored_unknown"
            ]
          },
          "original_owner_id": {
            "type": "string"
          },
          "current_owner_id": {
            "type": "string"
          },
          "current_location": {
            "type": "string"
          },
          "dojutsu_type": {
            "type": "string"
          },
          "hardware_stage": {
            "type": "string"
          },
          "mangekyo_identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "native_to_current_owner": {
            "type": "boolean"
          },
          "condition": {
            "type": "string"
          },
          "vision_integrity": {
            "type": "number",
            "minimum": 0,
            "maximum": 200
          },
          "integration": {
            "type": "number",
            "minimum": 0,
            "maximum": 200
          },
          "activation_state": {
            "type": "string"
          },
          "preservation_state": {
            "type": "string"
          },
          "unique_ability_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "obito_stockpile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_ref"
      ],
      "properties": {
        "inventory_ref": {
          "type": "string"
        }
      }
    }
  }
}
