{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "mechanical_consequence_authority",
    "total_recorded",
    "attempts"
  ],
  "properties": {
    "schema": {
      "const": "jianghu-interaction-attempt-ledger-1.0"
    },
    "authority": {
      "const": false
    },
    "mechanical_consequence_authority": {
      "const": false
    },
    "total_recorded": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_ref",
          "at",
          "surface_digest",
          "actor_ref",
          "target_ref",
          "action",
          "process_ref",
          "player_statement",
          "posture",
          "topic",
          "scopes",
          "world_response_status",
          "scene_session_ref",
          "thread_status",
          "resolved_at",
          "response_ref"
        ],
        "properties": {
          "attempt_ref": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "surface_digest": {
            "type": "string",
            "minLength": 1
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "person",
              "opposing_combat_side"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "process_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "player_statement": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "posture": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "topic": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 32
          },
          "world_response_status": {
            "const": "not_established_by_attempt"
          },
          "scene_session_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "thread_status": {
            "enum": [
              "open",
              "answered",
              "abandoned_with_scene_close",
              "not_applicable"
            ]
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
