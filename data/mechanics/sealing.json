{
  "schema": "sealing-mechanics.v38",
  "formulas": {
    "seal_strength": "method_mastery + 0.35*chakra_control + 0.30*sealing_domain + 0.20*Intelligence + preparation + medium_quality",
    "break_capacity": "counter_method_mastery + 0.35*chakra_output + 0.25*sealing_domain + 0.20*Intelligence + external_support",
    "net_margin": "seal_strength-break_capacity",
    "degradation_per_6s": "max(0,-net_margin)/10",
    "maintenance_recovery_per_6s": "max(0,net_margin)/20 when maintenance is supplied"
  },
  "states": [
    "unprepared",
    "prepared",
    "active",
    "strained",
    "breached",
    "collapsed"
  ],
  "rule": "Containment, suppression and escape use registered seal parameters; biju seals and forbidden seals may define additional deterministic costs/consequences.",
  "margin_bands": {
    "<=-30": "seal_breached_or_never_takes_hold",
    "-29_to_-1": "strained_and_degrading",
    "0_to_19": "holds_weakly",
    "20_to_49": "stable",
    "50_plus": "strongly_stable_within_registered_capacity"
  }
}
