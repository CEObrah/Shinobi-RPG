{
  "schema": "file-template",
  "template_id": "template.causal-scheduler-index",
  "target_schema": "causal-scheduler-index",
  "source_schema": "game/schemas/causal-scheduler-index.schema.json",
  "scope": "mutable_state",
  "current_directories": [
    "state/time"
  ],
  "unknown_key_policy": "reject",
  "required_top_level_keys": [
    "authority",
    "bootstrap_source",
    "event_years",
    "host_buckets",
    "host_count",
    "metrics",
    "next_due",
    "owner_id",
    "owner_type",
    "pending_event_count",
    "schema",
    "seeded_at",
    "storage_version",
    "world_time"
  ],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": [
        "schema",
        "owner_id",
        "owner_type",
        "authority",
        "storage_version",
        "world_time",
        "seeded_at",
        "bootstrap_source",
        "host_count",
        "pending_event_count",
        "next_due",
        "host_buckets",
        "event_years",
        "metrics"
      ],
      "canonical_order": [
        "schema",
        "owner_id",
        "owner_type",
        "authority",
        "storage_version",
        "world_time",
        "seeded_at",
        "bootstrap_source",
        "host_count",
        "pending_event_count",
        "next_due",
        "host_buckets",
        "event_years",
        "metrics"
      ]
    },
    "/host_buckets": {
      "mode": "open_map"
    },
    "/host_buckets/*": {
      "mode": "closed",
      "allowed_keys": [
        "path",
        "count"
      ],
      "canonical_order": [
        "path",
        "count"
      ]
    },
    "/event_years": {
      "mode": "open_map"
    },
    "/event_years/*": {
      "mode": "closed",
      "allowed_keys": [
        "path",
        "count",
        "earliest_due",
        "latest_due"
      ],
      "canonical_order": [
        "path",
        "count",
        "earliest_due",
        "latest_due"
      ]
    },
    "/metrics": {
      "mode": "open_map"
    }
  },
  "type_contracts": {
    "": [
      "object"
    ],
    "/schema": [
      "string"
    ],
    "/owner_id": [
      "string"
    ],
    "/owner_type": [
      "string"
    ],
    "/authority": [
      "boolean"
    ],
    "/storage_version": [
      "integer"
    ],
    "/world_time": [
      "string"
    ],
    "/seeded_at": [
      "string"
    ],
    "/bootstrap_source": [
      "string"
    ],
    "/host_count": [
      "integer"
    ],
    "/pending_event_count": [
      "integer"
    ],
    "/next_due": [
      "string",
      "null"
    ],
    "/host_buckets": [
      "object"
    ],
    "/host_buckets/*": [
      "object"
    ],
    "/host_buckets/*/path": [
      "string"
    ],
    "/host_buckets/*/count": [
      "integer"
    ],
    "/event_years": [
      "object"
    ],
    "/event_years/*": [
      "object"
    ],
    "/event_years/*/path": [
      "string"
    ],
    "/event_years/*/count": [
      "integer"
    ],
    "/event_years/*/earliest_due": [
      "string",
      "null"
    ],
    "/event_years/*/latest_due": [
      "string",
      "null"
    ],
    "/metrics": [
      "object"
    ]
  },
  "array_contracts": {},
  "writing_rules": [
    "Load this template before creating or structurally editing a scheduler owner.",
    "Scheduler shards are one temporal authority; routing indexes never duplicate domain truth."
  ]
}
