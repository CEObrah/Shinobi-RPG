{
  "schema": "file-template",
  "template_id": "template.inventory-registry",
  "target_schema": "inventory-registry",
  "source_schema": "game/schemas/inventory-registry.schema.json",
  "scope": "mutable_state",
  "current_directories": [
    "state/inventory"
  ],
  "unknown_key_policy": "reject",
  "required_top_level_keys": [
    "schema",
    "authority",
    "holders"
  ],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": [
        "schema",
        "authority",
        "holders"
      ],
      "canonical_order": [
        "schema",
        "authority",
        "holders"
      ]
    },
    "/holders": {
      "mode": "open_map"
    },
    "/holders/*": {
      "mode": "open_map"
    }
  },
  "type_contracts": {
    "": [
      "object"
    ],
    "/schema": [
      "string"
    ],
    "/authority": [
      "boolean"
    ],
    "/holders": [
      "object"
    ],
    "/holders/*": [
      "object"
    ],
    "/holders/*/*": [
      "integer"
    ]
  },
  "array_contracts": {},
  "writing_rules": [
    "Holdings contain conserved exact quantities only.",
    "Never create quantity without a source stock, lawful purchase contract, or explicit world-producing reducer.",
    "A named unique item remains under named-item custody rather than this registry."
  ]
}
