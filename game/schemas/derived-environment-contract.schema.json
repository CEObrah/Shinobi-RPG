{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived environment runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "authority",
    "separation_invariants",
    "mechanical_channels"
  ],
  "properties": {
    "schema": {
      "const": "derived-environment-contract"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mutable_owner",
        "inputs",
        "rule"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "mutable_owner": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "separation_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mechanical_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
