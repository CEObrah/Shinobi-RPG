{
  "schema": "repository-map",
  "purpose": "Machine retrieval/write router. Mutable truth is never stored here.",
  "hot": [
    "RUNTIME.md",
    "VOICE.md",
    "data/runtime/repository-map.json",
    "state/meta.json",
    "state/player.json",
    "state/scene.json"
  ],
  "owner_index": "state/index/owners.json",
  "mechanics_router": "data/runtime/rule-router.json",
  "temporal_engine": "data/runtime/temporal-settlement.json",
  "maintenance": [
    "schemas/",
    "tools/",
    "tests/"
  ],
  "retrieval_invariants": [
    "Load smallest causal owner/shard.",
    "Known IDs use direct paths before discovery indexes.",
    "Stop when enough authority is loaded.",
    "Indexes/caches are never gameplay truth.",
    "Writes update authority first, then receipts/derived caches, then validate/read back.",
    "Only this repository is authority.",
    "Before any structural write, load the target file template, registered blank owner skeleton, and relevant system update contract; existing owners/examples never define structure.",
    "Unknown route name -> use route_index to load exactly one cold route shard."
  ],
  "routes": {
    "current_time_revision": {
      "r": ["state/meta.json"],
      "w": ["state/meta.json"]
    },
    "player_core": {
      "r": ["state/player.json"],
      "w": ["state/player.json"]
    },
    "current_scene": {
      "r": ["state/scene.json"],
      "w": ["state/scene.json"]
    },
    "owner_lookup": {
      "i": ["state/index/owners.json"],
      "note": "Known owner_id -> use prefix_index and load only matching owner-index prefix shard."
    },
    "time_frontier": {
      "r": ["state/time/frontier.json"],
      "domain": "time_settlement",
      "note": "Frontier owns current world time and due boundaries only. Static coverage requirements are data/runtime/coverage-requirements.json; follow coverage_ref only for the process being settled."
    },
    "mechanics": {
      "i": ["data/runtime/rule-router.json"],
      "note": "Select one action-specific domain, not a broad union."
    },
    "player_interface": {
      "r": ["PLAYER_INTERFACE.md"]
    },
    "choice_presentation": {
      "domain": "choice_presentation"
    },
    "write_template_lookup": {
      "i": ["data/runtime/template-index.json", "data/runtime/blank-owner-index.json"],
      "note": "Before creating or structurally changing JSON, resolve target schema to its cold structural template and fact-free blank skeleton. No unregistered fields; missing or ambiguous structure stops persistence."
    },
    "system_update_contract": {
      "i": ["data/runtime/system-contract-index.json"],
      "note": "Before mutating a system, load only that system contract for authority/write order/invariants."
    },
    "narration_module": {
      "i": ["data/runtime/narration-router.json"],
      "note": "Load one primary scene module; at most one secondary when independently causal. VOICE.md remains the core persona."
    }
  },
  "route_index": {
    "loadout_known_id": "military",
    "command_capacity": "military",
    "unit_partition": "military",
    "unit_refit": "military",
    "mass_battle": "military",
    "unit_resolution": "military",
    "unit_return_reconstitution": "military",
    "teams": "military",
    "units": "military",
    "unit_capability": "military",
    "unit_kernel": "military",
    "forces": "military",
    "home_establishment": "military",
    "team_doctrine": "military",
    "formation": "military",
    "unit_development": "military",
    "equipment": "military",
    "formation_deployment": "military",
    "units_by_owner": "military",
    "command_group": "military",
    "command_tree": "military",
    "exact_characters": "people",
    "lite_people": "people",
    "npc_development": "people",
    "relationships_knowledge": "social",
    "reputation_subject": "social",
    "recognition_check": "social",
    "reputation_event": "social",
    "reputation_history": "social",
    "family_person": "social",
    "family_transition": "social",
    "family_succession": "social",
    "family_event": "social",
    "process_policy": "time",
    "process_coverage": "time",
    "doctrine_known_id": "world",
    "training_known_id": "world",
    "player_combat_detail": "world",
    "ambient_location_known_id": "world",
    "technique_known_id": "special",
    "technique_discovery": "special",
    "dojutsu_mechanics": "special",
    "ocular_assets": "special",
    "intel": "special",
    "family_kinship": "social",
    "character_behavior": "people",
    "character_behavior_profile": "people"
  },
  "route_shards": {
    "military": "data/runtime/repository-routes/military.json",
    "people": "data/runtime/repository-routes/people.json",
    "social": "data/runtime/repository-routes/social.json",
    "time": "data/runtime/repository-routes/time.json",
    "world": "data/runtime/repository-routes/world.json",
    "special": "data/runtime/repository-routes/special.json"
  },
  "directory_map": "data/runtime/directory-map.json",
  "blank_owner_index": "data/runtime/blank-owner-index.json"
}
