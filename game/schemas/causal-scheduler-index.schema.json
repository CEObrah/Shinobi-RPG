{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causal scheduler shard index",
  "type": "object",
  "required": [
    "schema",
    "owner_id",
    "owner_type",
    "authority",
    "storage_version",
    "world_time",
    "seeded_at",
    "bootstrap_source",
    "host_count",
    "pending_event_count",
    "next_due",
    "host_buckets",
    "event_years",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "causal-scheduler-index"
    },
    "owner_id": {
      "const": "runtime.causal_scheduler"
    },
    "owner_type": {
      "const": "causal_scheduler"
    },
    "authority": {
      "const": true
    },
    "storage_version": {
      "const": 2
    },
    "world_time": {
      "type": "string",
      "pattern": "^SE-[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "seeded_at": {
      "type": "string",
      "pattern": "^SE-[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "bootstrap_source": {
      "type": "string",
      "minLength": 1
    },
    "host_count": {
      "type": "integer",
      "minimum": 0
    },
    "pending_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "next_due": {
      "type": [
        "string",
        "null"
      ]
    },
    "host_buckets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^state/time/causal-scheduler/hosts/[0-9a-f]{2}\\.json$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "event_years": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "count",
          "earliest_due",
          "latest_due"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "earliest_due": {
            "type": [
              "string",
              "null"
            ]
          },
          "latest_due": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
