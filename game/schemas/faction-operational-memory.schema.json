{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema","faction_id","as_of","active_mission_team_refs","team_performance","recent_report_refs"],
  "properties":{
    "schema":{"const":"faction-operational-memory"},
