  "official_mission_supply": {
    "standard_issue_rule": "For village or institution-authorized missions, ordinary authorized mission equipment is issued from conserved institutional stock. The shinobi does not personally buy standard kunai, shuriken, wire, rations, or other approved mission consumables.",
    "loss_rule": "Consumed or legitimately lost issued equipment reduces institutional stock. Deliberate private acquisition, unauthorized loss, luxury upgrades, and personally retained replacements use personal money or an explicit separate authorization.",
    "reward_rule": "Mission cash terms are compensation/bonus, not reimbursement for ordinary authorized issue. Reward money must be escrowed from a real funding account when the mission is created."
  },
