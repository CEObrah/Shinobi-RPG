{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "dirs"
  ],
  "properties": {
    "schema": {
      "const": "directory-map"
    },
    "authority": {
      "const": false
    },
    "dirs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "authority",
              "note"
            ],
            "properties": {
              "authority": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
