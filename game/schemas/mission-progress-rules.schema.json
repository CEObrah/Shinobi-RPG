{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinobi.local/schemas/mission-progress-rules.schema.json",
  "title": "Mission Progress Rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "policy", "base_progress_milli_by_event_kind",
    "objective_mode", "doctrine", "maximum_nonterminal_progress_milli", "invariants"
  ],
  "properties": {
    "schema": {"const": "mission-progress-rules"},
    "version": {"const": 1},
    "policy": {"type": "string", "minLength": 1},
    "base_progress_milli_by_event_kind": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 999}
    },
    "objective_mode": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "doctrine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familiarity_bonus_floor", "familiarity_bonus_per_point_milli",
        "matching_mission_mode_bonus_milli", "complete_role_coverage_bonus_milli",
        "maximum_total_multiplier_milli"
      ],
      "properties": {
        "familiarity_bonus_floor": {"type": "integer", "minimum": 0, "maximum": 100},
        "familiarity_bonus_per_point_milli": {"type": "integer", "minimum": 0, "maximum": 20},
        "matching_mission_mode_bonus_milli": {"type": "integer", "minimum": 0, "maximum": 500},
        "complete_role_coverage_bonus_milli": {"type": "integer", "minimum": 0, "maximum": 500},
        "maximum_total_multiplier_milli": {"type": "integer", "minimum": 1000, "maximum": 2000}
      }
    },
    "maximum_nonterminal_progress_milli": {"type": "integer", "minimum": 1, "maximum": 999},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
