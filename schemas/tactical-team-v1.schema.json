{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactical Team",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "owner",
    "unit_refs"
  ],
  "properties": {
    "schema": {
      "const": "tactical-team"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "unit_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command_personnel": {
      "type": "object",
      "required": [
        "representation",
        "count",
        "includes_commander_slot",
        "groups"
      ],
      "properties": {
        "representation": {
          "const": "conserved_command_personnel"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "includes_commander_slot": {
          "const": true
        },
        "groups": {
          "type": "array"
        },
        "rule": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
