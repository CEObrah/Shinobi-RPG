  "background_selection_rule": "For a saved origin population and ordinal, a fixed modular permutation maps the ordinal into the 1000-slot background mix. No runtime RNG and no ChatGPT choice.",
  "origin_population_rules": {
    "candidate_identity": "candidate id = sha256(world_seed + origin_population_id + origin ordinal); same origin ordinal can never reroll",
    "population_conservation": "acceptance removes/reclassifies the exact selected aggregate person from the origin population and adds the same person to the destination faction",
    "screening": "recruiter/institution skill changes observation accuracy and number screened, never the candidate underlying aptitude",
    "rejection": "rejected candidates remain in the origin population unless another causal event moves them"
  }
}
