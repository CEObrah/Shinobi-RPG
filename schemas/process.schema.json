{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process",
  "type": "object",
  "required": [
    "schema",
    "id",
    "owner",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "process"
    },
    "id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "complete",
        "failed",
        "paused"
      ]
    },
    "last_review": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_review": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
