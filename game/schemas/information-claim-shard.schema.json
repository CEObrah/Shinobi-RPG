{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Information claim shard",
  "type": "object",
  "required": [
    "schema",
    "bucket",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "information-claim-shard"
    },
    "bucket": {
      "type": "string",
      "pattern": "^[0-9a-f]{4}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "claim_id",
          "subject_ref",
          "source_ref",
          "collected_at",
          "epistemic_kind",
          "confidence_milli",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim\\.[a-z0-9][a-z0-9._-]*$"
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "collected_at": {
            "type": "string",
            "pattern": "^SE--?[0-9]{4,}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "epistemic_kind": {
            "enum": [
              "observation",
              "report",
              "inference",
              "rumor"
            ]
          },
          "confidence_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
