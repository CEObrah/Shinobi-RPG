  "tournament_rules": {
    "individual": {
      "combat_engine": "full_exact",
      "victory": [
        "surrender",
        "incapacitation",
        "referee_stoppage",
        "ring_out_if_venue_uses_boundary"
      ],
      "persistent_injury": true,
      "death_possible": true
    }
  },
  "causal_events_rule": "Wars, feuds, marriages, assassinations, deaths, faction splits and political crises are not calendar flavor events. They require actual causal conditions and committed actor decisions.",
