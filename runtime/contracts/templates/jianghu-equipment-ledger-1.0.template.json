        "condition_milli"
      ],
      "canonical_order": [
        "items",
        "condition_milli"
      ]
    },
    "/person_loadouts/*/items": {
      "mode": "open_map"
    },
    "/person_loadouts/*/condition_milli": {
      "mode": "open_map"
    },
    "/provenance_exceptions": {
      "mode": "open_map"
    },
    "/provenance_exceptions/*": {
      "mode": "open_map"
    },
    "/provenance_exceptions/*/*": {
      "mode": "closed",
      "allowed_keys": ["owner_ref", "quantity", "property_ref", "status"],
      "canonical_order": ["owner_ref", "quantity", "property_ref", "status"]
    },
    "/recovery_demands": {
      "mode": "open_map"
    },
    "/recovery_demands/*": {
      "mode": "closed",
      "allowed_keys": ["owner_ref", "holder_ref", "item_ref", "quantity", "status", "issued_at", "property_ref", "evidence_ref"],
      "canonical_order": ["owner_ref", "holder_ref", "item_ref", "quantity", "status", "issued_at", "property_ref", "evidence_ref"]
    }
  },
  "type_contracts": {
    "": [
      "object"
    ],
