        "policy_assignments",
        "person_loadouts",
        "provenance_exceptions",
        "recovery_demands"
      ]
    },
    "/policy_assignments": {
      "mode": "open_map"
    },
    "/person_loadouts": {
      "mode": "open_map"
    },
    "/person_loadouts/*": {
      "mode": "closed",
      "allowed_keys": [
