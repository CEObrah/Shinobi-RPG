  "array_contracts": {
    "/commitments/*/resources": {
      "item_types": ["object"]
    },
    "/commitments/*/person_refs": {
      "item_types": ["string"]
    }
  },
  "writing_rules": [
    "Only unresolved current reservations belong here.",
    "Commitment rows are closed so named arrays retain their semantic pointers during structural validation.",
    "Resources are exact conserved reservations. Person arrays are current membership in the activity, never a fictional population cap."
  ]
