{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinobi.local/schemas/procedure-time-rules.schema.json",
  "title": "Procedure Time Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "policy", "procedures", "invariants"],
  "properties": {
    "schema": {"const": "procedure-time-rules"},
    "version": {"const": 1},
    "policy": {"type": "string", "minLength": 1},
    "procedures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["duration_seconds", "use"],
        "properties": {
          "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 21600},
          "use": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
