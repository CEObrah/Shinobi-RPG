        "briefing_templates": {
          "escort": {
            "subject_kind": "person",
            "subject_ref": "support.daimyo.noboru_shimizu",
            "subject_label": "Noboru Shimizu — Fire Daimyō civil-military liaison",
            "report_place_ref": "place.konoha.mission_assignment_desk",
            "origin_place_ref": "place.konoha",
            "destination_place_ref": "place.fire.capital",
            "route_id": "route_fire_capital_konoha",
            "threat_summary": "Elevated interception risk on civil-military liaison travel; no hostile actor has been identified.",
            "threat_source_ref": null,
            "intelligence_constraints": [
              "Treat route anomalies as evidence to verify, not proof of a named enemy.",
              "The principal takes priority over pursuit."
            ],
            "report_delay_hours": 2,
            "depart_delay_hours": 6,
            "completion_condition": "Escort Noboru Shimizu from Konoha to the Fire Capital without capture or incapacitation."
          },
          "border_reconnaissance": {
            "subject_kind": "place",
            "subject_ref": "place.fire.western.border",
            "subject_label": "Western Fire Country border reconnaissance sector",
            "report_place_ref": "place.konoha.mission_assignment_desk",
            "origin_place_ref": "place.konoha",
            "destination_place_ref": "place.fire.western.border",
            "route_id": "route_konoha_fire_west",
            "threat_summary": "Routine border reconnaissance with no hostile actor established; verify crossings, route condition, and any supported anomaly.",
            "threat_source_ref": null,
            "intelligence_constraints": [
              "Do not convert absence of records into proof of hostile activity.",
              "Report observed route, crossing, and security anomalies with provenance before attributing intent."
            ],
            "report_delay_hours": 2,
            "depart_delay_hours": 6,
            "completion_condition": "Reconnoiter the assigned western-border sector and return a sourced observation report to the Mission Office."
          },
          "investigate": {
            "subject_kind": "place",
            "subject_ref": "place.fire.western.border",
            "subject_label": "Western-border cargo-transfer discrepancy",
            "report_place_ref": "place.konoha.mission_assignment_desk",
            "origin_place_ref": "place.konoha",
            "destination_place_ref": "place.fire.western.border",
            "route_id": "route_konoha_fire_west",
            "threat_summary": "Possible deliberate interference with controlled cargo records on the western Fire Country route; criminal or hostile involvement is unconfirmed.",
            "threat_source_ref": null,
            "intelligence_constraints": [
              "Determine whether the discrepancy is clerical, criminal, or hostile before attributing intent.",
              "Preserve records, physical evidence, and available witnesses."
            ],
            "report_delay_hours": 2,
            "depart_delay_hours": 6,
            "completion_condition": "Establish a defensible account of the discrepancy and return the preserved evidence and findings to the Mission Office."
          },
          "protect": {
            "subject_kind": "person",
            "subject_ref": "support.daimyo.noboru_shimizu",
            "subject_label": "Noboru Shimizu — Fire Daimyō civil-military liaison",
            "report_place_ref": "place.konoha.mission_assignment_desk",
            "origin_place_ref": "place.konoha",
            "destination_place_ref": "place.fire.capital",
            "route_id": "route_fire_capital_konoha",
            "threat_summary": "Credible risk of targeted interception against Fire Country liaison traffic; no hostile actor has been identified.",
            "threat_source_ref": null,
            "intelligence_constraints": [
              "Do not attribute the threat to a faction or individual without evidence.",
              "Preserve the principal and a viable withdrawal route over unnecessary pursuit."
            ],
            "report_delay_hours": 2,
            "depart_delay_hours": 6,
            "completion_condition": "Keep Noboru Shimizu alive and free and deliver him to the Fire Capital under Konoha protection."
          }
        },
