{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinobi.local/schemas/environment-action-rules.schema.json",
  "title": "Environment Action Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "policy", "interval_sample_count", "actions", "invariants"],
  "properties": {
    "schema": {"const": "environment-action-rules"},
    "version": {"const": 1},
    "policy": {"type": "string", "minLength": 1},
    "interval_sample_count": {"type": "integer", "minimum": 2, "maximum": 16},
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum_factor_milli", "maximum_factor_milli", "channels"],
        "properties": {
          "minimum_factor_milli": {"type": "integer", "minimum": 1, "maximum": 2000},
          "maximum_factor_milli": {"type": "integer", "minimum": 1, "maximum": 2000},
          "channels": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "polarity"],
              "properties": {
                "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
                "polarity": {"enum": ["direct", "inverse"]}
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
