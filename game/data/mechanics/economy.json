    "large_residence_replacement_ryo": 20000000,
    "small_estate_replacement_ryo": 60000000,
    "fortified_manor_replacement_ryo": 250000000,
    "elite_compound_replacement_ryo": 500000000,
    "academy_wing_ryo": 20000000,
    "hospital_wing_ryo": 35000000,
    "major_security_upgrade_ryo": 30000000,
    "minor_hidden_village_infrastructure_ryo": 3000000000,
    "great_hidden_village_infrastructure_ryo": 30000000000,
    "rule": "Capital references are planning/valuation anchors, not automatic sale prices and not mutable ownership facts."
  },
  "mission_pricing_rule": {
    "typical_team_size_reference": 4,
    "rule": "At the typical point, client fee must cover four typical participant bonuses plus the typical operational allowance. Rank maxima must be high enough to fund four maximum participant bonuses plus the operational allowance. Village subsidies and mission-market aggregation may still absorb exceptional strategic work, but routine paid missions are not structurally loss-making."
  }
}
