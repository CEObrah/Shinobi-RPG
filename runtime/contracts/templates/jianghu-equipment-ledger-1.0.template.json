{
  "schema": "file-template",
  "template_id": "template.jianghu-equipment-ledger-1.0",
  "target_schema": "jianghu-equipment-ledger-1.0",
  "source_schema": null,
  "scope": "mutable_state",
  "current_directories": [
    "state/martial-world"
  ],
  "unknown_key_policy": "reject",
  "required_top_level_keys": [
    "schema"
  ],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": [
        "schema",
        "policy_assignments",
        "person_loadouts",
        "provenance_exceptions",
        "recovery_demands"
      ],
      "canonical_order": [
