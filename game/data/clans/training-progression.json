{
  "schema": "clan-training-progression.v2",
  "principles": {
    "instruction_access_is_not_mastery": true,
    "promotion_is_not_automatic_from_capability": true,
    "village_career_rank_is_separate": true,
    "standing_and_technical_tier_are_separate": true
  },
  "institutions": {
    "house.tang": {
      "kind": "formal_rank_ladder",
      "rank_requirements_ref": "game/data/house/ranks.json",
      "standing_order": [
        "junior_disciple",
        "senior_disciple",
        "assistant_instructor",
        "senior_instructor",
        "sword_master"
      ],
      "technical_tier_order": ["junior", "senior", "master"],
      "standing_to_technical_tier": {
        "junior_disciple": "junior",
        "senior_disciple": "senior",
        "assistant_instructor": "senior",
        "senior_instructor": "senior",
        "sword_master": "master"
      },
      "technical_tiers": {
        "junior": {"package_ref": "PKG_HT_JUNIOR"},
        "senior": {"package_ref": "PKG_HT_SENIOR"},
        "master": {"package_ref": "PKG_HT_SWORD_MASTER"}
      },
      "promotion": {
        "automatic": false,
        "direct_next_standing_only": true,
        "require_all_numeric_minimums": true,
        "require_all_credentials": true,
        "review_authority_refs": ["char.zhu"],
        "delegated_review_refs": ["char.linh"],
        "rostered_promotion_requires_identity_preservation": true,
        "rostered_promotion_materializes_exact_person": true
      }
    },
    "clan.nara": {
      "kind": "instruction_access_ladder",
      "membership_package_ref": "PKG_NARA_CLAN_CORE",
