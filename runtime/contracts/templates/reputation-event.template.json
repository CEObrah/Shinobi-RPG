{
  "schema": "file-template",
  "template_id": "template.reputation-event",
  "target_schema": "reputation-event",
  "source_schema": "game/schemas/reputation-event.schema.json",
  "scope": "mutable_state",
  "current_directories": [],
  "unknown_key_policy": "reject",
  "required_top_level_keys": ["authority", "event_id", "event_type", "occurred_at", "schema", "signals", "subject_id", "visibility"],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": ["schema", "event_id", "subject_id", "event_type", "occurred_at", "source_event_ref", "authority", "signals", "standing_signals", "visibility", "witnesses", "report_routes", "deliveries", "status"],
      "canonical_order": ["schema", "event_id", "subject_id", "event_type", "occurred_at", "source_event_ref", "authority", "signals", "standing_signals", "visibility", "witnesses", "report_routes", "deliveries", "status"]
    },
    "/signals": {"mode": "open_map"},
    "/standing_signals": {"mode": "open_map"},
    "/visibility": {"mode": "open_map"},
    "/deliveries": {"mode": "open_map"},
    "/signals/*": {"mode": "closed", "allowed_keys": ["score", "base_weight"], "canonical_order": ["score", "base_weight"]},
    "/standing_signals/*": {"mode": "closed", "allowed_keys": ["score", "base_weight"], "canonical_order": ["score", "base_weight"]},
    "/deliveries/*": {"mode": "closed", "allowed_keys": ["profile_ref", "source_event_ref"], "canonical_order": ["profile_ref", "source_event_ref"]}
  },
  "type_contracts": {
    "": ["object"],
    "/schema": ["string"],
    "/event_id": ["string"],
    "/subject_id": ["string"],
    "/event_type": ["string"],
    "/occurred_at": ["string"],
    "/source_event_ref": ["null", "string"],
    "/authority": ["boolean"],
    "/signals": ["object"],
    "/standing_signals": ["object"],
    "/visibility": ["object"],
    "/witnesses": ["array"],
    "/report_routes": ["array"],
    "/deliveries": ["object"],
    "/status": ["string"],
    "/signals/*": ["object"],
    "/signals/*/score": ["integer"],
    "/signals/*/base_weight": ["integer"],
    "/standing_signals/*": ["object"],
    "/standing_signals/*/score": ["integer"],
    "/standing_signals/*/base_weight": ["integer"],
    "/deliveries/*": ["object"],
    "/deliveries/*/profile_ref": ["string"],
    "/deliveries/*/source_event_ref": ["string"],
    "/visibility/*": ["string"],
    "/witnesses/*": ["string"],
    "/report_routes/*": ["string"]
  },
  "array_contracts": {
    "/witnesses": {"item_types": ["string"]},
    "/report_routes": {"item_types": ["string"]}
  },
  "writing_rules": [
    "Load this cold template before creating a file of this type or adding/removing structural fields.",
    "Do not add unregistered fields. New structure requires maintenance-time schema/template revision before gameplay writes.",
    "Open maps allow dynamic IDs only; value structure still follows the wildcard contract when defined.",
    "A template controls shape, not campaign facts. Never copy example values from another owner."
  ]
}
