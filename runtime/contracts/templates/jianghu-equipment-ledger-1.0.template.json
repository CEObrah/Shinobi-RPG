      "integer"
    ],
    "/person_loadouts/*/condition_milli": [
      "object"
    ],
    "/person_loadouts/*/condition_milli/*": [
      "integer"
    ],
    "/provenance_exceptions": ["object"],
    "/provenance_exceptions/*": ["object"],
    "/provenance_exceptions/*/*": ["object"],
    "/provenance_exceptions/*/*/owner_ref": ["string"],
    "/provenance_exceptions/*/*/quantity": ["integer"],
    "/provenance_exceptions/*/*/property_ref": ["string"],
    "/provenance_exceptions/*/*/status": ["string"],
    "/recovery_demands": ["object"],
    "/recovery_demands/*": ["object"],
    "/recovery_demands/*/owner_ref": ["string"],
    "/recovery_demands/*/holder_ref": ["string"],
    "/recovery_demands/*/item_ref": ["string"],
    "/recovery_demands/*/quantity": ["integer"],
    "/recovery_demands/*/status": ["string"],
    "/recovery_demands/*/issued_at": ["string"],
    "/recovery_demands/*/property_ref": ["string"],
    "/recovery_demands/*/evidence_ref": ["string"]
