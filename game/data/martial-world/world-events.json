  "calendar_rule": "Calendar events are generated from exact dates and host cycles. Registration and brackets are deterministic from eligible saved entrants; no narrator-created event or entrant.",
  "causal_event_templates": {
    "master_death_succession": {
      "requires": [
        "leader_or_master_death",
        "eligible_successors"
      ],
      "result": "succession_process"
    },
    "faction_foundation": {
      "requires": [
        "founder",
        "followers",
        "funded_site_or_lease",
        "charter_type"
      ],
      "result": "new_independent_faction"
    },
    "faction_split": {
      "requires": [
        "internal_conflict",
        "lawful_departing_members",
        "asset_split"
      ],
      "result": "two_conserved_factions"
    },
    "faction_dissolution": {
      "requires": [
        "zero_viable_leadership_or_membership_decision"
      ],
      "result": "members_and_assets_reclassified"
    },
    "formal_challenge": {
      "requires": [
        "challenger",
        "target",
        "known_grievance_or_reputation_goal"
      ],
      "result": "delivered_challenge_offer"
    },
    "feud_escalation": {
      "requires": [
        "hostility_threshold",
        "recent_grievance",
        "capability_to_act"
      ],
      "result": "hostile_commitment"
    },
    "marriage_negotiation": {
      "requires": [
        "eligible_people",
        "lawful_family_or_self_authority",
        "mutual_interest"
      ],
      "result": "proposal_or_negotiation"
    },
    "outlaw_bounty_issue": {
      "requires": [
        "delivered_crime_evidence",
        "jurisdiction",
        "funding"
      ],
      "result": "active_warrant_and_government_response"
    },
    "escort_demand": {
      "requires": [
        "saved_shipment",
        "route",
        "cargo",
        "payer"
      ],
      "result": "funded_escort_offer"
    },
    "market_shortage": {
      "requires": [
        "market_stock_below_threshold"
      ],
      "result": "price_pressure_and_trade_demand"
    },
    "medical_emergency": {
      "requires": [
        "actual_injury_or_disease_owner"
      ],
      "result": "treatment_need"
    },
    "leadership_vacancy": {
      "requires": [
        "vacant_office"
      ],
      "result": "appointment_or_succession_review"
    },
    "tournament_rivalry": {
      "requires": [
        "public_match_result",
        "relationship_update"
      ],
      "result": "reputation_and_optional_challenge_pressure"
    },
    "government_crackdown": {
      "requires": [
        "delivered_crime_evidence",
        "attention_threshold"
      ],
      "result": "mobilization_or_bounty"
    },
    "outlaw_fragmentation": {
      "requires": [
        "leadership_loss_or_severe_shortage",
        "surviving_members"
      ],
      "result": "split_merge_surrender_or_dissolve_review"
    },
    "talent_competition": {
      "requires": [
        "known_recruit_candidate",
        "multiple_interested_factions"
      ],
      "result": "competing_recruitment_offers"
    }
  }
