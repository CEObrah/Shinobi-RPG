{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "person_id",
    "name",
    "authority",
    "mode",
    "source_refs",
    "known_anchors",
    "decision_basis",
    "dialogue_constraints",
    "narration_rule"
  ],
  "properties": {
    "schema": {
      "const": "behavior-profile.v1"
    },
    "person_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "authority": {
      "const": false
    },
    "mode": {
      "const": "evidence_limited_role_driven"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_anchors": {
      "type": "object",
      "required": [
        "origin",
        "current_goal",
        "institutional_duties",
        "role_anchors",
        "rank_anchor",
        "affiliation_anchor",
        "source_class"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "current_goal": {
          "type": "string"
        },
        "institutional_duties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rank_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "affiliation_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decision_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dialogue_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narration_rule": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
