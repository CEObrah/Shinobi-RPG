  "manufacturing_schedule": {
    "standing_weekly_active_hours": 40,
    "max_weekly_active_hours": 48,
    "settlement": "Standing schedules accrue only their registered full-time weekly active hours in proportion to elapsed campaign time. Production lines multiply staffed throughput. Unfunded full-batch labor is not banked as catch-up debt; only the sub-batch remainder persists.",
    "procurement": "Each completed batch transfers its registered procurement cost from the institution funding holder to the contractor economy before finished goods enter conserved stock."
  },
  "rules": {
    "resource_payment": "All listed stock costs are consumed exactly once when the project starts. Empty stock costs mean a bundled capital contract includes procurement in the registered currency price.",
    "labor": "Authorized institutional labor is represented by deterministic work units per active hour. A project does not create a separate population body.",
    "completion": "A facility module changes only when accumulated work reaches the required work units.",
    "cancellation": "Cancelling stops future work and does not refund already consumed resources.",
    "concurrency": "At most one active project of the same type may target the same place.",
    "financial_payment": "Each project type pays its registered ryo cost exactly once at project start from the institution funding account into the contractor economy. Currency is transferred, never destroyed.",
    "facility_prerequisites": "A project may declare requires_modules only when another existing mechanical module is genuinely required. No decorative prerequisite module is created merely to unlock a project.",
    "production_boundary": "Production capacity never creates finished equipment by itself. Manufacturing requires a registered recipe, a real production line, elapsed institutional labor, conserved procurement currency, and a stock owner that already tracks the output item.",
    "scaling": "Cardinality capacity fields and production-line counts are additive results of completed, funded facility projects and have no universal ceiling. Only normalized quality, security, throughput, defense and similar effectiveness scales retain registered caps. Build more physical capacity to obtain more slots or lines."
  }
