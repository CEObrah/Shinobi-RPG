{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Troop Pool",
  "description": "Capability-source classification for aggregate military simulation. It is not a conserved personnel partition and cannot fight directly; operational combat is represented by formations.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "count",
    "capability_ref"
  ],
  "properties": {
    "schema": {
      "const": "troop_pool"
    },
    "id": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "type": "string"
    },
    "troop_type": {
      "type": "string"
    },
    "readiness_class": {
      "type": "string"
    },
    "capability_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
