{
  "persistent_stats": [
    "qi",
    "qi_control"
  ],
  "resource": "current_qi ranges from 0 to current maximum Qi stat; maximum Qi equals the current Qi capability value.",
  "formulas": {
    "control_efficiency": "qi_control / (qi_control + 100)",
    "effective_cultivation": "0 if qi + qi_control == 0 else (2 * qi * qi_control) / (qi + qi_control)",
    "biological_aging_rate": "1 / sqrt(1 + effective_cultivation / 100)",
    "rest_recovery_per_hour": "max_qi * 0.05 * (0.5 + 0.5 * control_efficiency)",
    "sleep_recovery_per_hour": "max_qi * 0.10 * (0.5 + 0.5 * control_efficiency)",
    "safe_flow_per_second": "sqrt(max(qi,0)) * (1 + control_efficiency)",
    "redistribution_latency_seconds": "0.60 / (1 + qi_control / 100)",
    "external_projection_decay": "projected_effect_at_distance = release_effect * exp(-distance_m / max(0.25, qi_control / 100))"
  },
  "universal_applications": [
    "body_reinforcement",
    "localized_reinforcement",
