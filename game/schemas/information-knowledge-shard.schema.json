{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Information holder claim-membership shard",
  "type": "object",
  "required": [
    "schema",
    "holder_ref",
    "holder_hash",
    "bucket",
    "claim_refs"
  ],
  "properties": {
    "schema": {
      "const": "information-knowledge-shard"
    },
    "holder_ref": {
      "type": "string",
      "minLength": 1
    },
    "holder_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$"
    },
    "bucket": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}$"
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^claim\\."
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
