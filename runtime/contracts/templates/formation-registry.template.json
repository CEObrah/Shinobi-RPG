{
  "schema": "file-template",
  "template_id": "template.formation-registry",
  "target_schema": "formation-registry",
  "source_schema": "game/schemas/formation-registry.schema.json",
  "scope": "mutable_state",
  "current_directories": [
    "state/formation"
  ],
  "unknown_key_policy": "reject",
  "required_top_level_keys": [
    "authority",
    "force_ref",
    "formations",
    "owner_id",
    "owner_type",
    "schema"
  ],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": [
        "schema",
        "owner_id",
        "owner_type",
        "authority",
        "force_ref",
        "formations"
      ],
      "canonical_order": [
        "schema",
        "owner_id",
        "owner_type",
        "authority",
        "force_ref",
        "formations"
      ]
    },
    "/formations/*": {
      "mode": "closed",
      "allowed_keys": [
        "id",
        "name",
        "force_ref",
        "role",
        "lifecycle_origin",
        "personnel_total",
        "authorized_personnel",
        "doctrine_ref",
        "training_ref",
        "cohesion",
        "morale",
        "readiness",
        "location_ref",
        "activity_summary",
        "tendencies",
        "command_slot",
        "command_personnel",
        "components",
        "operational_objective"
      ],
      "canonical_order": [
        "id",
        "name",
        "force_ref",
        "role",
        "lifecycle_origin",
        "personnel_total",
        "authorized_personnel",
        "doctrine_ref",
        "training_ref",
        "cohesion",
        "morale",
        "readiness",
        "location_ref",
        "activity_summary",
        "tendencies",
        "command_slot",
        "command_personnel",
        "components",
        "operational_objective"
      ]
    },
    "/formations/*/tendencies": {
      "mode": "open_map"
    },
    "/formations/*/command_slot": {
      "mode": "closed",
      "allowed_keys": [
        "representation",
        "profile_ref"
      ],
      "canonical_order": [
        "representation",
        "profile_ref"
      ]
    },
    "/formations/*/command_personnel": {
      "mode": "closed",
      "allowed_keys": [
        "representation",
        "count",
        "includes_commander_slot",
        "groups"
      ],
      "canonical_order": [
        "representation",
        "count",
        "includes_commander_slot",
        "groups"
      ]
    },
    "/formations/*/components/*": {
      "mode": "closed",
      "allowed_keys": [
        "id",
        "troop_type",
        "role",
        "count",
        "rank_distribution",
        "condition",
        "tendency_profile_ref"
      ],
      "canonical_order": [
        "id",
        "troop_type",
        "role",
        "count",
        "rank_distribution",
        "condition",
        "tendency_profile_ref"
      ]
    },
    "/formations/*/components/*/rank_distribution": {
      "mode": "open_map"
    },
    "/formations/*/components/*/condition": {
      "mode": "open_map"
    },
    "/formations/*/command_personnel/groups/*": {
      "mode": "closed",
      "allowed_keys": [
        "count",
        "rank_distribution",
        "condition"
      ],
      "canonical_order": [
        "count",
        "rank_distribution",
        "condition"
      ]
    },
    "/formations/*/command_personnel/groups/*/rank_distribution": {
      "mode": "open_map"
    },
    "/formations/*/command_personnel/groups/*/condition": {
      "mode": "open_map"
    },
    "/formations/*/operational_objective": {
      "mode": "closed",
      "allowed_keys": [
        "kind",
        "target_refs",
        "lethal_authorized"
      ],
      "canonical_order": [
        "kind",
        "target_refs",
        "lethal_authorized"
      ]
    }
  },
