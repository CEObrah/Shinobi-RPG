{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema","team_id","as_of","missions_total","missions_succeeded","missions_failed","training_sessions","casualty_events","replacement_events","former_member_refs","notable_event_refs","last_mission_ref","last_result_at"],
  "properties": {
    "schema": {"const": "team-operational-history"},
    "team_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "missions_total": {"type": "integer", "minimum": 0},
    "missions_succeeded": {"type": "integer", "minimum": 0},
    "missions_failed": {"type": "integer", "minimum": 0},
    "training_sessions": {"type": "integer", "minimum": 0},
    "casualty_events": {"type": "integer", "minimum": 0},
    "replacement_events": {"type": "integer", "minimum": 0},
    "former_member_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notable_event_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "last_mission_ref": {"type": ["string","null"]},
    "last_result_at": {"type": ["string","null"]}
  },
  "additionalProperties": false
}
