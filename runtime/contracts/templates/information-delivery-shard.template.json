{
  "schema": "file-template",
  "template_id": "template.information-delivery-shard",
  "target_schema": "information-delivery-shard",
  "source_schema": "game/schemas/information-delivery-shard.schema.json",
  "scope": "mutable_state",
  "current_directories": [
    "state/reg/information"
  ],
  "unknown_key_policy": "reject",
  "required_top_level_keys": [
    "bucket",
    "deliveries",
    "schema"
  ],
  "object_contracts": {
    "": {
      "mode": "closed",
      "allowed_keys": [
        "schema",
        "bucket",
        "deliveries"
      ],
      "canonical_order": [
        "schema",
        "bucket",
        "deliveries"
      ]
    },
    "/deliveries": {
      "mode": "open_map"
    },
    "/deliveries/*": {
      "mode": "closed",
      "allowed_keys": [
        "delivery_id",
        "claim_id",
        "sender_ref",
        "recipient_ref",
        "channel",
        "delivered_at",
        "resulting_epistemic_kind",
        "resulting_confidence_milli",
        "evidence_refs"
      ],
      "canonical_order": [
        "delivery_id",
        "claim_id",
        "sender_ref",
        "recipient_ref",
        "channel",
        "delivered_at",
        "resulting_epistemic_kind",
        "resulting_confidence_milli",
        "evidence_refs"
      ]
    }
  },
  "type_contracts": {
    "": [
      "object"
    ],
    "/schema": [
      "string"
    ],
    "/bucket": [
      "string"
    ],
    "/deliveries": [
      "object"
    ],
    "/deliveries/*": [
      "object"
    ],
    "/deliveries/*/delivery_id": [
      "string"
    ],
    "/deliveries/*/claim_id": [
      "string"
    ],
    "/deliveries/*/sender_ref": [
      "string"
    ],
    "/deliveries/*/recipient_ref": [
      "string"
    ],
    "/deliveries/*/channel": [
      "string"
    ],
    "/deliveries/*/delivered_at": [
      "string"
    ],
    "/deliveries/*/resulting_epistemic_kind": [
      "string"
    ],
    "/deliveries/*/resulting_confidence_milli": [
      "integer"
    ],
    "/deliveries/*/evidence_refs": [
      "array"
    ],
    "/deliveries/*/evidence_refs/*": [
      "string"
    ]
  },
  "array_contracts": {
    "/deliveries/*/evidence_refs": {
      "item_types": [
        "string"
      ]
    }
  },
  "writing_rules": [
    "Load this template before creating or structurally editing a target owner.",
    "Exact information authority is sharded deterministically; the root routing index is never claim/delivery/knowledge truth.",
    "World truth is not knowledge."
  ]
}
